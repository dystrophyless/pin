# Copy to /opt/pin/shared/runtime.env on the host; keep the destination root-readable only.
# Generate a URL-safe database password with: openssl rand -hex 32
PIN_DB_PASSWORD=replace_with_64_hex_characters
PIN_BOT_TOKEN=00000:replace_with_bot_token
PIN_OPENROUTER_API_KEY=replace_with_openrouter_key
PIN_PAYMENT_SUPPORT_CONTACT=
COMPOSE_PROFILES=landing-http
PIN_DOMAIN=
